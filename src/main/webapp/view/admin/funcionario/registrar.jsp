<%@ page language=\"java\" contentType=\"text/html; charset=UTF-8\" pageEncoding=\"UTF-8\"%>\n<%@ page import=\"com.ojj.academico.model.Departamento\" %>\n<%@ page import=\"com.ojj.academico.service.RegistroResult\" %>\n<%@ page import=\"java.util.List\" %>\n<!DOCTYPE html>\n<html lang=\"pt\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>OJJ Académico • Registo de Funcionário</title>\n    <link rel=\"stylesheet\" href=\"<%= request.getContextPath() %>/assets/css/all.min.css\">\n    <link rel=\"stylesheet\" href=\"<%= request.getContextPath() %>/assets/css/bootstrap.min.css\">\n    <link rel=\"stylesheet\" href=\"<%= request.getContextPath() %>/assets/css/main.css\">\n    <style>\n        .registro-card {\n            border-radius: 16px;\n            padding: 32px;\n            background: rgba(255, 255, 255, 0.95);\n            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.08);\n        }\n        .form-label {\n            font-weight: 600;\n            color: #1e3a5f;\n            margin-bottom: 8px;\n        }\n        .form-control-custom {\n            border-radius: 8px;\n            border: 1px solid #e0e7ff;\n            padding: 10px 14px;\n            font-size: 14px;\n        }\n        .btn-primary-custom {\n            background: linear-gradient(135deg, #1e3a5f 0%, #2d5a9e 100%);\n            border: none;\n            border-radius: 8px;\n            font-weight: 600;\n            padding: 10px 24px;\n            transition: all 0.3s ease;\n        }\n        .btn-primary-custom:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 8px 20px rgba(30, 58, 95, 0.3);\n        }\n        .sucesso-box {\n            background: #f0fdf4;\n            border-left: 4px solid #22c55e;\n            padding: 20px;\n            border-radius: 8px;\n            margin-bottom: 24px;\n        }\n        .sucesso-box h5 {\n            color: #16a34a;\n            margin-bottom: 12px;\n        }\n        .credenciais-display {\n            background: #1e293b;\n            color: #e2e8f0;\n            padding: 16px;\n            border-radius: 8px;\n            font-family: 'Courier New', monospace;\n            font-size: 13px;\n            overflow-x: auto;\n            margin: 12px 0;\n            white-space: pre-wrap;\n        }\n        .badge-perfil {\n            background: rgba(49, 130, 206, 0.1);\n            color: #1e3a5f;\n            font-weight: 600;\n            padding: 6px 12px;\n            border-radius: 20px;\n        }\n    </style>\n</head>\n<body>\n    <nav class=\"navbar navbar-expand-lg navbar-custom\">\n        <div class=\"container-fluid\">\n            <a class=\"navbar-brand\" href=\"<%= request.getContextPath() %>/admin/dashboard\">\n                <i class=\"fas fa-university\"></i> OJJ Académico\n            </a>\n            <div class=\"navbar-nav ms-auto\">\n                <a class=\"nav-link\" href=\"<%= request.getContextPath() %>/admin/dashboard\">\n                    <i class=\"fas fa-arrow-left\"></i> Voltar\n                </a>\n            </div>\n        </div>\n    </nav>\n\n    <div class=\"container my-5\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-lg-6\">\n                <%\n                    RegistroResult registroSucesso = (RegistroResult) session.getAttribute(\"registroSucesso\");\n                    String erro = (String) request.getAttribute(\"erro\");\n                %>\n                \n                <% if (registroSucesso != null) { %>\n                    <div class=\"sucesso-box\">\n                        <h5><i class=\"fas fa-check-circle\"></i> Funcionário Registado com Sucesso!</h5>\n                        <p class=\"mb-2\"><strong>Nome:</strong> <%= registroSucesso.getNomeFuncionario() %></p>\n                        <p class=\"mb-2\"><strong>Email:</strong> <%= registroSucesso.getEmail() %></p>\n                        <p class=\"mb-3\"><strong>Perfil:</strong> <span class=\"badge-perfil\"><%= registroSucesso.getNomePerfil() %></span></p>\n                        \n                        <p class=\"mb-2 text-muted\">Credenciais de acesso geradas:</p>\n                        <div class=\"credenciais-display\">Email: <%= registroSucesso.getEmail() %>\nSenha Temporária: <%= registroSucesso.getSenhaTemporaria() %>\n\nO funcionário deverá alterar a senha no primeiro acesso.</div>\n                        \n                        <p class=\"text-muted small\">As credenciais foram armazenadas em: <%= registroSucesso.getCaminhoCredenciais() %></p>\n                        \n                        <a href=\"<%= request.getContextPath() %>/admin/funcionario/registrar\" class=\"btn btn-primary-custom w-100 mt-3\">\n                            <i class=\"fas fa-plus\"></i> Registar Outro Funcionário\n                        </a>\n                    </div>\n                    <%\n                        session.removeAttribute(\"registroSucesso\");\n                    %>\n                <% } else if (erro != null) { %>\n                    <div class=\"alert alert-danger alert-dismissible fade show\" role=\"alert\">\n                        <i class=\"fas fa-exclamation-circle\"></i> <%= erro %>\n                        <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"alert\" aria-label=\"Close\"></button>\n                    </div>\n                <% } %>\n                \n                <div class=\"registro-card\">\n                    <h3 class=\"mb-4\"><i class=\"fas fa-user-plus\"></i> Registo de Funcionário</h3>\n                    <p class=\"text-muted mb-4\">Preencha o formulário abaixo para registar um novo funcionário. As credenciais de acesso serão geradas automaticamente.</p>\n                    \n                    <form method=\"post\" action=\"<%= request.getContextPath() %>/admin/funcionario/registrar\">\n                        <div class=\"row g-3\">\n                            <div class=\"col-md-12\">\n                                <label class=\"form-label\">Tipo de Funcionário *</label>\n                                <select name=\"idPerfil\" class=\"form-select form-control-custom\" required>\n                                    <option value=\"\">Selecione o tipo...</option>\n                                    <option value=\"2\">Secretário</option>\n                                    <option value=\"3\">Tesoureiro</option>\n                                    <option value=\"5\">Coordenador</option>\n                                    <option value=\"8\">Coordenador do Curso</option>\n                                </select>\n                            </div>\n                            \n                            <div class=\"col-md-12\">\n                                <label class=\"form-label\">Nome Completo *</label>\n                                <input type=\"text\" name=\"nomeCompleto\" class=\"form-control form-control-custom\" required>\n                            </div>\n                            \n                            <div class=\"col-md-12\">\n                                <label class=\"form-label\">Email *</label>\n                                <input type=\"email\" name=\"email\" class=\"form-control form-control-custom\" required>\n                            </div>\n                            \n                            <div class=\"col-md-6\">\n                                <label class=\"form-label\">Número de BI *</label>\n                                <input type=\"text\" name=\"numeroBi\" class=\"form-control form-control-custom\" required>\n                            </div>\n                            \n                            <div class=\"col-md-6\">\n                                <label class=\"form-label\">Sexo</label>\n                                <select name=\"sexo\" class=\"form-select form-control-custom\">\n                                    <option value=\"M\">Masculino</option>\n                                    <option value=\"F\">Feminino</option>\n                                </select>\n                            </div>\n                            \n                            <div class=\"col-md-6\">\n                                <label class=\"form-label\">Telefone</label>\n                                <input type=\"tel\" name=\"telefone\" class=\"form-control form-control-custom\" placeholder=\"+244\">\n                            </div>\n                            \n                            <div class=\"col-md-6\">\n                                <label class=\"form-label\">Data de Nascimento</label>\n                                <input type=\"date\" name=\"dataNascimento\" class=\"form-control form-control-custom\">\n                            </div>\n                            \n                            <div class=\"col-md-12\">\n                                <label class=\"form-label\">Morada</label>\n                                <input type=\"text\" name=\"morada\" class=\"form-control form-control-custom\" placeholder=\"Rua, Número, Cidade\">\n                            </div>\n                            \n                            <div class=\"col-md-12\">\n                                <label class=\"form-label\">Departamento</label>\n                                <select name=\"idDepartamento\" class=\"form-select form-control-custom\">\n                                    <option value=\"\">Selecione o departamento...</option>\n                                    <%\n                                        List<Departamento> departamentos = (List<Departamento>) request.getAttribute(\"departamentos\");\n                                        if (departamentos != null) {\n                                            for (Departamento dept : departamentos) {\n                                    %>\n                                    <option value=\"<%= dept.getIdDepartamento() %>\"><%= dept.getNomeDepartamento() %></option>\n                                    <%\n                                            }\n                                        }\n                                    %>\n                                </select>\n                            </div>\n                            \n                            <div class=\"col-md-6\">\n                                <label class=\"form-label\">Salário</label>\n                                <input type=\"number\" name=\"salario\" class=\"form-control form-control-custom\" step=\"0.01\" placeholder=\"0.00\">\n                            </div>\n                            \n                            <div class=\"col-md-6\">\n                                <label class=\"form-label\">Data de Admissão *</label>\n                                <input type=\"date\" name=\"dataAdmissao\" class=\"form-control form-control-custom\" required>\n                            </div>\n                            \n                            <div class=\"col-md-12\">\n                                <button type=\"submit\" class=\"btn btn-primary-custom w-100\">\n                                    <i class=\"fas fa-save\"></i> Registar Funcionário\n                                </button>\n                            </div>\n                        </div>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <script src=\"<%= request.getContextPath() %>/assets/js/bootstrap.bundle.min.js\"></script>\n</body>\n</html>\n