    <!-- =================================================================== -->
    <!-- FILTROS DE AUTENTICAÇÃO E AUTORIZAÇÃO -->
    <!-- =================================================================== -->

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.ojj.academico.filters.AuthFilter</filter-class>
    </filter>

    <!-- Proteger URLs administrativas -->
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <!-- Proteger URLs de professor -->
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/professor/*</url-pattern>
    </filter-mapping>

    <!-- Proteger URLs de estudante -->
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/estudante/*</url-pattern>
    </filter-mapping>

    <!-- Proteger URLs de secretaria -->
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/secretario/*</url-pattern>
    </filter-mapping>

    <!-- Proteger URLs de tesouraria -->
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/tesouraria/*</url-pattern>
    </filter-mapping>

    <!-- Proteger URLs de coordenação -->
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/coordenador/*</url-pattern>
    </filter-mapping>

    <!-- Proteger URLs de relatórios -->
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/relatorios/*</url-pattern>
    </filter-mapping>

    <!-- Proteger URLs do sistema -->
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/sistema/*</url-pattern>
    </filter-mapping>

    <!-- =================================================================== -->
    <!-- LISTENERS -->
    <!-- =================================================================== -->

    <listener>
        <listener-class>com.ojj.academico.init.AppInitializer</listener-class>
    </listener>

    <!-- =================================================================== -->
    <!-- CONFIGURAÇÕES GLOBAIS -->
    <!-- =================================================================== -->

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Configuração de erro 404 -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error/404.jsp</location>
    </error-page>

    <!-- Configuração de erro 500 -->
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>

    <!-- Configuração de erro de acesso negado -->
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/error/403.jsp</location>
    </error-page>

    <!-- Tempo de sessão em minutos -->
    <session-config>
        <cookie-config>
            <secure>false</secure>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Configuração de MIME types -->
    <mime-mapping>
        <extension>pdf</extension>
        <mime-type>application/pdf</mime-type>
    </mime-mapping>

</web-app>
